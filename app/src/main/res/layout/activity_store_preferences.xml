<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Store Notifications"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Choose which stores you want to receive notifications for. Stores are automatically discovered from your location."
            android:textSize="14sp"
            android:textColor="@android:color/darker_gray"
            android:layout_marginBottom="16dp" />

        <!-- No Stores Message (hidden when stores found) -->
        <TextView
            android:id="@+id/tvNoStores"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No stores found in cache."
            android:textSize="14sp"
            android:textColor="@android:color/holo_orange_dark"
            android:background="#FFF3E0"
            android:padding="16dp"
            android:gravity="center"
            android:layout_marginBottom="16dp"
            android:visibility="gone" />

        <!-- Bulk Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btnSelectAll"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Select All"
                android:textSize="14sp"
                android:layout_marginEnd="8dp"
                style="?android:attr/buttonBarButtonStyle" />

            <Button
                android:id="@+id/btnDeselectAll"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Deselect All"
                android:textSize="14sp"
                android:layout_marginStart="8dp"
                style="?android:attr/buttonBarButtonStyle" />
        </LinearLayout>

        <!-- Dynamic Store List Container -->
        <LinearLayout
            android:id="@+id/storeListContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp" />

        <!-- Info Note -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💡 Tip: Select only stores where you actually shop to avoid unnecessary notifications."
            android:textSize="12sp"
            android:textColor="@android:color/holo_blue_dark"
            android:background="#E3F2FD"
            android:padding="12dp"
            android:layout_marginBottom="16dp" />

        <!-- Save Button -->
        <Button
            android:id="@+id/btnSavePreferences"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save Preferences"
            android:textSize="16sp" />

    </LinearLayout>

</ScrollView>
